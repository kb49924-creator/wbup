# ============================================
# Wildberries Channel Manager — настройки
# ============================================
# Скопируйте этот файл в .env и заполните:
#   cp .env.example .env
# ============================================

# ---------------------------
# Telegram
# ---------------------------

# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=ваш_токен_бота

# Имя канала для публикаций (с @)
CHANNEL_USERNAME=@ваш_канал

# ---------------------------
# Proxy для Telegram API
# ---------------------------
# Оставьте пустым, если не нужен.
# Пример: socks5://user:pass@127.0.0.1:1080
#         http://proxy.example.com:8080
TELEGRAM_PROXY=

# ---------------------------
# Режим отбора товаров
# ---------------------------
#   popular — популярные (много отзывов)
#   new     — новые (20-300 отзывов)
#   mixed   — смешанный (по умолчанию)
MODE=mixed

# ---------------------------
# Локальная LLM (Ollama) для классификации фото
# ---------------------------

# URL Ollama API (по умолчанию http://127.0.0.1:11434)
OLLAMA_URL=http://127.0.0.1:11434

# Модель для vision-классификации (должна поддерживать изображения)
# Рекомендации: llava:13b, llava:7b, bakllava, minicpm-v, cogv2
OLLAMA_MODEL=llava:13b

# Таймаут запроса к Ollama в секундах
OLLAMA_TIMEOUT=30

# ---------------------------
# Кэш изображений
# ---------------------------

# Очищать кэш изображений при каждом запуске бота.
# Полезно после обновления алгоритмов выбора фото или удаления фона.
# Если false — фото переиспользуются (экономит трафик).
# CLEAR_IMAGE_CACHE_ON_START=true